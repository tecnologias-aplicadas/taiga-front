nav.navbar(ng-if="vm.isEnabledHeader")
    .nav-left
        a.logo(
            ng-if="!vm.isAuthenticated"
            href="#",
            tg-nav="home",
            title="{{'PROJECT.NAVIGATION.HOMEPAGE' | translate}}"
        )
            include ../../svg/logo_taiga_parquetec.svg

        a.logo(
            ng-if="vm.isAuthenticated"
            href="#",
            tg-nav="dashboard",
            title="{{'PROJECT.NAVIGATION.HOMEPAGE' | translate}}"
        )
            include ../../svg/logo_taiga_parquetec.svg

        .topnav-dropdown-wrapper(
            ng-if="vm.isAuthenticated"
            tg-dropdown-project-list
            active="vm.active == 'projects' || vm.active == 'project'"
        )

    .nav-right.center(ng-if="!vm.isAuthenticated")
        .br-tag.environment-tag(ng-if="vm.environment === 'local'")
            tg-svg(svg-icon="icon-info")
            span {{'COMMON.ENVIRONMENT.LOCAL' | translate}}

        .br-tag.environment-tag(ng-if="vm.environment === 'develop'")
                tg-svg(svg-icon="icon-info")
                span {{'COMMON.ENVIRONMENT.DEVELOP' | translate}}

        .br-tag.environment-tag(ng-if="vm.environment === 'staging'")
                tg-svg(svg-icon="icon-info")
                span {{'COMMON.ENVIRONMENT.STAGING' | translate}}
        a.login(
            ng-click="vm.login()"
            href="#",
            title="{{ 'LOGIN_COMMON.ACTION_SIGN_IN' | translate }}"
            translate="LOGIN_COMMON.ACTION_SIGN_IN"
        )

    .nav-right(ng-if="vm.isAuthenticated")
        .br-tag.environment-tag(ng-if="vm.environment === 'local'")
                tg-svg(svg-icon="icon-info")
                span {{'COMMON.ENVIRONMENT.LOCAL' | translate}}

        .br-tag.environment-tag(ng-if="vm.environment === 'develop'")
                tg-svg(svg-icon="icon-info")
                span {{'COMMON.ENVIRONMENT.DEVELOP' | translate}}

        .br-tag.environment-tag(ng-if="vm.environment === 'staging'")
                tg-svg(svg-icon="icon-info")
                span {{'COMMON.ENVIRONMENT.STAGING' | translate}}
