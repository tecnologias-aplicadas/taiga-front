        section.section.best-practices-section
            h2.section-title {{ 'STORY_POINTS_GUIDE.BEST_PRACTICES_TITLE' | translate }}
            ul.best-practices-list
                li
                    tg-svg(svg-icon="icon-check")
                    span {{ 'STORY_POINTS_GUIDE.BEST_PRACTICES_1' | translate }}
                li
